# Copy to .env (gitignored, never commit it): cp .env.example .env
# Promptfoo and the chat UI (npm run chat) both load it automatically.

# Anthropic (Claude Haiku + Sonnet): https://console.anthropic.com/settings/keys
# Optional: without it, Claude uses your Claude Code session (`claude /login`).
# With it, calls are billed to your Anthropic account.
# ANTHROPIC_API_KEY=

# --- Paused providers (commented out in promptfooconfig.yaml; evals only, not the chat UI) ---

# Google Gemini: https://aistudio.google.com/apikey (free tier on a project without billing).
# GOOGLE_API_KEY=
# Retry Google's "high demand" 503s with backoff instead of recording them as errors.
PROMPTFOO_RETRY_5XX=true

# Groq: https://console.groq.com/keys
# GROQ_API_KEY=
