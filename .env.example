# Copy to .env (gitignored). Promptfoo loads it automatically.

# Optional locally: without it, Claude uses your Claude Code session (`claude /login`).
# ANTHROPIC_API_KEY=

# Google Gemini: https://aistudio.google.com/apikey (free tier on a project without billing).
GOOGLE_API_KEY=
# Retry Google's "high demand" 503s with backoff instead of recording them as errors.
PROMPTFOO_RETRY_5XX=true

# Groq (currently disabled in the configs): https://console.groq.com/keys
# GROQ_API_KEY=
